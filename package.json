{
  "scripts": {
    "build-ridership-dev": "esbuild assets/ridership-map/js/index.js --bundle --format=esm --splitting --loader:.png=empty --outdir=assets/dist/",
    "build-ridership": "esbuild assets/ridership-map/js/index.js --bundle --format=esm --splitting --minify --loader:.png=empty --outdir=assets/dist/",
    "watch-ridership": "esbuild assets/ridership-map/js/index.js --bundle --format=esm --splitting --loader:.png=empty --outdir=assets/dist/ --watch",
    "build-density-dev": "esbuild assets/density-map/js/index.js --bundle --format=esm --loader:.png=empty --outfile=assets/dist/density.js",
    "build-density": "esbuild assets/density-map/js/index.js --bundle --format=esm --minify --loader:.png=empty --outfile=assets/dist/density.js",
    "watch-density": "esbuild assets/density-map/js/index.js --bundle --format=esm --loader:.png=empty --outfile=assets/dist/density.js --watch",
    "build-tracts": "mapshaper assets/density-map/data/tract/tract20.shp -proj wgs84 -simplify 30% -filter-fields GEOID20,ALANDMI,POP2010,POP2011,POP2012,POP2013,POP2014,POP2015,POP2016,POP2017,POP2018,POP2019,POP2020,POP2021,POP2022,POP2023,POP2024,POP2025 -o format=topojson assets/density-map/data/tract/tract20.json",
    "build-blocks": "mapshaper assets/density-map/data/block/block20.shp -proj wgs84 -simplify 30% -filter-fields GEOID20,ALANDMI,POP2010,POP2011,POP2012,POP2013,POP2014,POP2015,POP2016,POP2017,POP2018,POP2019,POP2020,POP2021,POP2022,POP2023,POP2024,POP2025 -o format=topojson quantization=1e5 assets/density-map/data/block/block20.json",
    "build-block-groups": "mapshaper assets/density-map/data/blockgroup/SAEP_Census_Block_Groups.shp -proj wgs84 from=webmercator -simplify 30% -filter-fields GEOID20,ALANDMI,POP2010,POP2011,POP2012,POP2013,POP2014,POP2015,POP2016,POP2017,POP2018,POP2019,POP2020,POP2021,POP2022,POP2023,POP2024,POP2025 -o format=topojson assets/density-map/data/blockgroup/blockgroup20.json",
    "build-all": "npm run build-ridership && npm run build-density && npm run build-tracts && npm run build-blocks && npm run build-block-groups"
  },
  "dependencies": {
    "bootstrap": "^5.3.8",
    "d3": "^7.9.0",
    "d3-hexbin": "^0.2.2",
    "leaflet": "^1.9.4",
    "topojson-client": "^3.1.0",
    "vega": "^6.2.0",
    "vega-lite": "^6.4.2",
    "vega-tooltip": "^1.1.0"
  },
  "devDependencies": {
    "esbuild": "^0.27.3",
    "mapshaper": "^0.6.121"
  }
}
